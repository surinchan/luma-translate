{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma Translate",
  "version": "0.6.4",
  "identifier": "com.luma.selection-translator",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "button",
        "url": "button.html",
        "width": 42,
        "height": 42,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "panel",
        "url": "panel.html",
        "width": 400,
        "height": 280,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "manual",
        "url": "manual.html",
        "title": "输入文本翻译",
        "width": 560,
        "height": 440,
        "minWidth": 480,
        "minHeight": 380,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "center": true
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Luma Translate 设置",
        "width": 430,
        "height": 500,
        "visible": true,
        "decorations": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "shortDescription": "划词翻译工具",
    "longDescription": "鼠标划词后通过 LLM API 翻译的跨平台桌面工具"
  }
}
